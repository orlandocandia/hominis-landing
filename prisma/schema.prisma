// Prisma Schema — Hominis CRM (Fase 1: Fundación de datos)
// =========================================================
// 12 modelos CRM + Contacto (legacy, leads de la landing).
// Los triggers del SQL spec se implementan como lógica de app (decisión B: Prisma).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ─── ENUMS ───

enum Rol {
  ADMIN
  VENDEDOR
  PRODUCTOR
}

enum GeocodingStatus {
  PENDING
  SUCCESS
  FAILED
}

enum PhoneType {
  PERSONAL
  LABORAL
  WHATSAPP
  URGENCIAS
  OTRO
}

enum EmailType {
  PERSONAL
  LABORAL
  ALTERNATIVO
  OTRO
}

enum SocialPlatform {
  INSTAGRAM
  FACEBOOK
  LINKEDIN
  TWITTER
  TIKTOK
  YOUTUBE
  TELEGRAM
  DISCORD
  SNAPCHAT
  OTRO
}

enum ContactSegment {
  RECIBO_DE_SUELDO
  MONOTRIBUTO
  PARTICULAR
}

enum ContactCoverage {
  CABA
  GBA
}

enum ContactStatus {
  NUEVO
  LEIDO
  EN_CONTACTO
  REUNION
  PRESUPUESTO
  ATENDIDO
  RECHAZADO
}

enum ActivityAction {
  CREADO
  LEIDO
  EN_CONTACTO
  REUNION
  PRESUPUESTO
  ATENDIDO
  RECHAZADO
  NOTA
  LLAMADA
  WHATSAPP
  EMAIL
  VISITA
}

enum AssignmentMethod {
  ROUND_ROBIN
  GEOGRAPHIC
  CAPACITY
  MANUAL
}

enum NotificationType {
  CONTACT
  ASSIGNMENT
  REMINDER
  SYSTEM
}

enum InvitationRole {
  VENDEDOR
  PRODUCTOR
}

enum SourceCategory {
  PAID
  ORGANIC
  SOCIAL
  REFERRAL
  DIRECT
}

// ═══════════════════════════════════════════════════════
// USER (existente, extendido con perfil CRM)
// ═══════════════════════════════════════════════════════

model User {
  id              String          @id @default(cuid())
  email           String          @unique
  password        String          // bcrypt hash
  nombre          String
  apellido        String?
  telefono        String?         // legacy; multicanal en UserPhone
  rol             Rol             @default(VENDEDOR)
  activo          Boolean         @default(true)
  fechaAlta       DateTime        @default(now())
  ultimoAcceso    DateTime?
  intentosLogin   Int             @default(0)
  bloqueadoHasta  DateTime?

  // Perfil extendido (Fase 1)
  avatarUrl       String?
  avatarPublicId  String?
  avatarUpdatedAt DateTime?
  address         String?
  city            String?
  province        String?
  postalCode      String?
  latitude        Float?
  longitude       Float?
  geocodingStatus GeocodingStatus @default(PENDING)
  serviceRadius   Int             @default(50)
  coverageAreas   String?         // JSON string
  documentNumber  String?
  hireDate        DateTime?

  // Métricas (actualizadas por lógica de app, ver lib/metrics.ts en Fase 3)
  totalContacts   Int             @default(0)
  conversionRate  Float           @default(0)

  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  // Relaciones
  phones           UserPhone[]
  emails           UserEmail[]
  socialNetworks   UserSocialNetwork[]
  ownedContacts    Contact[]           @relation("ContactOwner")
  assignedContacts Contact[]           @relation("ContactAssignedBy")
  activities       ContactActivity[]
  assignments      AutomaticAssignment[] @relation("AssignmentAssignedTo")
  invitationsSent  Invitation[]        @relation("InvitationInvitedBy")
  notifications    Notification[]
  followups        Followup[]
  reminders        Reminder[]

  @@index([email])
  @@index([latitude, longitude])
}

// ═══════════════════════════════════════════════════════
// MULTICANAL — USER
// ═══════════════════════════════════════════════════════

model UserPhone {
  id          String    @id @default(cuid())
  userId      String
  phoneNumber String
  phoneType   PhoneType
  isPrimary   Boolean   @default(false)
  isWhatsapp  Boolean   @default(false)
  isVerified  Boolean   @default(false)
  notes       String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, phoneNumber])
  @@index([phoneNumber])
}

model UserEmail {
  id         String   @id @default(cuid())
  userId     String
  email      String
  emailType  EmailType
  isPrimary  Boolean  @default(false)
  isVerified Boolean  @default(false)
  notes      String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, email])
  @@index([email])
}

model UserSocialNetwork {
  id        String         @id @default(cuid())
  userId    String
  platform  SocialPlatform
  username  String
  url       String?
  isPrimary Boolean        @default(false)
  notes     String?
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, platform, username])
}

// ═══════════════════════════════════════════════════════
// CONTACT (CRM)
// Distinto de Contacto (legacy, leads de landing).
// En Fase 3 se migrarán los Contacto → Contact.
// ═══════════════════════════════════════════════════════

model Contact {
  id              String          @id @default(cuid())
  name            String
  primaryEmail    String?
  primaryPhone    String?
  address         String
  city            String?
  province        String?
  postalCode      String?
  latitude        Float?
  longitude       Float?
  geocodingStatus GeocodingStatus @default(PENDING)
  photoUrl        String?
  photoPublicId   String?
  segment         ContactSegment?
  age             Int?
  coverage        ContactCoverage?
  message         String?
  status          ContactStatus   @default(NUEVO)
  ownerId         String
  assignedBy      String?
  assignedAt      DateTime        @default(now())
  lastContact     DateTime?
  nextFollowup    DateTime?

  // Lead scoring (optimización Fase 1)
  leadScore       Int?      @default(0)
  leadPriority    String?   @default("MEDIA")
  leadScoredAt    DateTime?
  leadScoreHistory String?  // JSON string of [{score, priority, date}]

  // Marketing analytics (Fase 2)
  sourceId          String?
  sourceUtmSource   String?
  sourceUtmMedium   String?
  sourceUtmCampaign String?
  sourceReferrer    String?

  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  owner          User  @relation("ContactOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  assignedByUser User? @relation("ContactAssignedBy", fields: [assignedBy], references: [id])
  phones         ContactPhone[]
  emails         ContactEmail[]
  socialNetworks ContactSocialNetwork[]
  activities     ContactActivity[]
  assignments    AutomaticAssignment[]
  followups      Followup[]
  reminders      Reminder[]

  @@index([latitude, longitude])
  @@index([ownerId])
  @@index([status])
}

model ContactPhone {
  id          String    @id @default(cuid())
  contactId   String
  phoneNumber String
  phoneType   PhoneType
  isPrimary   Boolean   @default(false)
  isWhatsapp  Boolean   @default(false)
  isVerified  Boolean   @default(false)
  notes       String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  contact Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@unique([contactId, phoneNumber])
  @@index([phoneNumber])
}

model ContactEmail {
  id         String   @id @default(cuid())
  contactId  String
  email      String
  emailType  EmailType
  isPrimary  Boolean  @default(false)
  isVerified Boolean  @default(false)
  notes      String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  contact Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@unique([contactId, email])
  @@index([email])
}

model ContactSocialNetwork {
  id        String         @id @default(cuid())
  contactId String
  platform  SocialPlatform
  username  String
  url       String?
  isPrimary Boolean        @default(false)
  notes     String?
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  contact Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@unique([contactId, platform, username])
}

// ═══════════════════════════════════════════════════════
// ACTIVIDADES + ASIGNACIONES + INVITACIONES + NOTIFICACIONES
// ═══════════════════════════════════════════════════════

model ContactActivity {
  id        String         @id @default(cuid())
  contactId String
  userId    String
  action    ActivityAction
  note      String?
  metadata  String? // JSON string
  createdAt DateTime       @default(now())

  contact Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id])

  @@index([contactId])
  @@index([userId])
}

model AutomaticAssignment {
  id         String           @id @default(cuid())
  contactId  String
  assignedTo String
  method     AssignmentMethod
  distanceKm Float?
  reason     String?
  createdAt  DateTime         @default(now())

  contact        Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)
  assignedToUser User    @relation("AssignmentAssignedTo", fields: [assignedTo], references: [id])

  @@index([assignedTo])
}

model Invitation {
  id        String          @id @default(cuid())
  email     String
  role      InvitationRole
  token     String          @unique
  invitedBy String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime        @default(now())

  invitedByUser User @relation("InvitationInvitedBy", fields: [invitedBy], references: [id])

  @@index([email])
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  type      NotificationType
  title     String
  message   String
  read      Boolean          @default(false)
  link      String?
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ═══════════════════════════════════════════════════════
// SEGUIMIENTO AUTOMATIZADO (Fase 4)
// ═══════════════════════════════════════════════════════

model FollowupTemplate {
  id        String     @id @default(cuid())
  name      String
  type      String     // 'EMAIL', 'WHATSAPP', 'CALL'
  subject   String?
  body      String
  delayDays Int        @default(1)
  isActive  Boolean    @default(true)
  createdAt DateTime   @default(now())

  followups Followup[]
}

model Followup {
  id            String    @id @default(cuid())
  contactId     String
  userId        String
  scheduledDate DateTime
  executedDate  DateTime?
  status        String    @default("PENDING") // PENDING, SENT, FAILED, SKIPPED
  type          String    // 'EMAIL', 'WHATSAPP', 'CALL'
  templateId    String?
  content       String?
  metadata      String?
  createdAt     DateTime  @default(now())

  contact   Contact           @relation(fields: [contactId], references: [id], onDelete: Cascade)
  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  template  FollowupTemplate? @relation(fields: [templateId], references: [id])

  @@index([contactId])
  @@index([userId])
  @@index([status, scheduledDate])
}

model Reminder {
  id            String    @id @default(cuid())
  contactId     String
  userId        String
  reminderDate  DateTime
  title         String
  description   String?
  type          String    // 'CALL', 'EMAIL', 'MEETING', 'OTHER'
  isCompleted   Boolean   @default(false)
  completedAt   DateTime?
  createdAt     DateTime  @default(now())

  contact Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([contactId])
  @@index([userId, isCompleted, reminderDate])
}

// ═══════════════════════════════════════════════════════
// MARKETING ANALYTICS (Fase 2)
// ═══════════════════════════════════════════════════════

model LeadSource {
  id        String         @id @default(cuid())
  name      String         @unique
  category  SourceCategory
  isActive  Boolean        @default(true)
  createdAt DateTime       @default(now())

  metrics SourceMetric[]

  @@index([category])
}

model SourceMetric {
  id             String   @id @default(cuid())
  sourceId       String
  date           DateTime @default(now())
  leads          Int      @default(0)
  conversions    Int      @default(0)
  conversionRate Float    @default(0)
  cost           Float    @default(0)
  createdAt      DateTime @default(now())

  source LeadSource @relation(fields: [sourceId], references: [id], onDelete: Cascade)

  @@unique([sourceId, date])
  @@index([date])
}

// ═══════════════════════════════════════════════════════
// CONTACTO (LEGACY — leads de la landing pública)
// Se preserva tal cual. En Fase 3 se migrarán a Contact.
// ═══════════════════════════════════════════════════════

model Contacto {
  id        String   @id @default(cuid())
  nombre    String
  email     String
  telefono  String
  segmento  String
  mensaje   String?
  cobertura String?
  edad      Int?
  origen    String   @default("landing")
  ip        String?
  estado    String   @default("NUEVO")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([email])
  @@index([segmento])
  @@index([createdAt])
  @@index([estado])
}
