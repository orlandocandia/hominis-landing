// Prisma Schema - ContactoModel (Leads)
// Equivalent to the MySQL table for lead management

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Contacto {
  id        String   @id @default(cuid())
  nombre    String   // Full name
  email     String   // Email address
  telefono  String   // Phone number (WhatsApp)
  segmento  String   // Segment: PARTICULAR, MONOTRIBUTISTA, EMPLEADO_DEPENDENCIA
  mensaje   String?  // Optional message
  cobertura String?  // Coverage interest: BSAS, NACIONAL, INTERNACIONAL
  edad      Int?     // Age (must be <= 64)
  origen    String   @default("landing") // Lead origin tracking
  ip        String?  // Client IP for security
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([email])
  @@index([segmento])
  @@index([createdAt])
}
