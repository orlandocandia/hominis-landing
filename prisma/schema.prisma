// Prisma Schema - ContactoModel (Leads) + User Auth

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Contacto {
  id        String   @id @default(cuid())
  nombre    String   // Full name
  email     String   // Email address
  telefono  String   // Phone number (WhatsApp)
  segmento  String   // Segment: RECIBO_DE_SUELDO, MONOTRIBUTO, PARTICULAR
  mensaje   String?  // Optional message
  cobertura String?  // Coverage interest: CABA_GBA
  edad      Int?     // Age (must be <= 64)
  origen    String   @default("landing") // Lead origin tracking
  ip        String?  // Client IP for security
  estado    String   @default("NUEVO") // NUEVO, LEIDO, ATENDIDO
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([email])
  @@index([segmento])
  @@index([createdAt])
  @@index([estado])
}

model User {
  id              String    @id @default(cuid())
  email           String    @unique // Login email
  password        String    // Hashed password (bcrypt)
  nombre          String    // First name
  apellido        String?   // Last name (optional)
  telefono        String?   // Phone (optional)
  rol             Rol       @default(ASESOR) // ADMIN o ASESOR
  activo          Boolean   @default(true)
  fechaAlta       DateTime  @default(now()) // Registration date
  ultimoAcceso    DateTime? // Last successful login
  intentosLogin   Int       @default(0) // Brute-force protection: failed attempts
  bloqueadoHasta  DateTime? // Brute-force protection: lockout until
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([email])
}

enum Rol {
  ADMIN
  ASESOR
}
