# Base de datos SQLite (desarrollo local)
DATABASE_URL=file:./db/custom.db

# Turso (producción en Vercel) - Descomentá estas líneas y comentá la de arriba
# DATABASE_URL=libsql://tu-base-de-datos.turso.io
# DATABASE_AUTH_TOKEN=tu-auth-token-aqui

# NextAuth
# Generá un secret propio con: openssl rand -base64 32
NEXTAUTH_SECRET=tu-secret-seguro-aqui
# URL pública de la app (desarrollo: http://localhost:3000, producción: https://www.asesoradesalud.com.ar)
NEXTAUTH_URL=http://localhost:3000

# ── Para probar el login LOCALMENTE contra SQLite (opcional) ──
# El auth usa Turso por defecto (credenciales en src/lib/turso-config.ts).
# Para apuntar el auth a tu SQLite local durante desarrollo, descomentá:
# TURSO_URL=file:./db/custom.db
